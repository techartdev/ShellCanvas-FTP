{
  "schemaVersion": 1,
  "id": "dev.shellcanvas.ftp",
  "name": "FTP files",
  "version": "0.1.0",
  "description": "Browse and download files over explicit FTPS or FTP. Upload and file changes are not available.",
  "platform": "current",
  "entrypoint": "bin/shellcanvas-ftp{exe}",
  "files": [{ "path": "bin/shellcanvas-ftp{exe}", "executable": true }],
  "configuration": [
    { "id": "host", "label": "FTP server", "kind": "text", "required": true },
    { "id": "port", "label": "Port", "kind": "number", "required": true, "default": 21 },
    { "id": "username", "label": "Username", "kind": "text", "required": true },
    { "id": "password", "label": "Password", "kind": "password", "required": true },
    { "id": "tls", "label": "Use explicit FTPS (TLS)", "kind": "boolean", "default": true },
    { "id": "trustCertificate", "label": "Trust self-signed FTPS certificate", "kind": "boolean", "default": false }
  ]
}
